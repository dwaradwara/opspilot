global:
  resolve_timeout: 5m

route:
  receiver: "default"
  group_by:
    - alertname
    - environment
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 4h

receivers:
  - name: "default"
    sns_configs:
      - send_resolved: true
        topic_arn: "${sns_topic_arn}"
        sigv4:
          region: "${region}"
        subject: "[OpsPilot] {{ .Status | toUpper }} - {{ .CommonLabels.alertname }}"
        message: |
          OpsPilot Alert

          Status: {{ .Status }}
          Alert: {{ .CommonLabels.alertname }}
          Environment: {{ .CommonLabels.environment }}
          Severity: {{ .CommonLabels.severity }}

          {{ range .Alerts }}
          Summary: {{ .Annotations.summary }}
          Description: {{ .Annotations.description }}
          {{ end }}
