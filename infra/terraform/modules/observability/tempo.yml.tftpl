stream_over_http_enabled: true

server:
  http_listen_port: 3200
  grpc_listen_port: 9096

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"

ingester:
  max_block_duration: 5m

compactor:
  compaction:
    block_retention: 24h

storage:
  trace:
    backend: s3

    wal:
      path: /var/tempo/wal

    s3:
      bucket: ${bucket_name}
      endpoint: s3.${region}.amazonaws.com
      region: ${region}

usage_report:
  reporting_enabled: false
